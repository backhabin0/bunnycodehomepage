---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/structuredData';

const base = import.meta.env.BASE_URL; // '/bunnycode/'
const siteOrigin = import.meta.env.SITE ?? 'https://hanapage.co.kr';
const pageUrl = new URL('affordable-homepage/', `${siteOrigin}${base}`).href;
const homeUrl = new URL('', `${siteOrigin}${base}`).href;

const title = '가성비 홈페이지 제작 | 필요한 기능부터 합리적으로 | 바니코드';
const description =
  '필요 없는 기능은 줄이고 사업에 필요한 구성부터 시작하는 가성비 홈페이지 제작. 소상공인, 1인 사업자, 신규 브랜드에 맞춰 제작 범위를 설계합니다.';

const faqItems = [
  {
    question: '가성비 홈페이지는 일반 홈페이지와 무엇이 다른가요?',
    answer:
      '다른 제품이 아니라 접근 방식의 차이입니다. 처음부터 모든 기능을 넣기보다, 지금 사업에 꼭 필요한 페이지와 기능만 먼저 구성해 범위를 합리적으로 설계합니다.',
  },
  {
    question: '제작 비용은 무엇에 따라 달라지나요?',
    answer:
      '페이지 수, 디자인 범위, 반응형 여부, 회원·예약·결제 같은 추가 기능, 외부 API 연동 여부 등에 따라 달라집니다. 정확한 견적은 상담을 통해 안내해드립니다.',
  },
  {
    question: '한 페이지짜리 사이트도 제작 가능한가요?',
    answer: '네. 소개와 문의만 필요한 경우 한 페이지 구성으로도 충분히 제작할 수 있습니다.',
  },
  {
    question: '나중에 기능을 추가할 수 있나요?',
    answer: '네. 처음에는 핵심 기능만 제작하고, 회원·예약·결제 등은 필요해졌을 때 단계적으로 추가하는 방식으로 진행할 수 있습니다.',
  },
  {
    question: '도메인과 호스팅은 어떻게 하나요?',
    answer: '이미 보유하고 계신 도메인이 있다면 연결해드리고, 없다면 준비되는 시점에 맞춰 진행할 수 있습니다.',
  },
  {
    question: 'SEO도 포함할 수 있나요?',
    answer:
      '네. 기본 제작 범위 안에서 메타데이터, sitemap 등 SEO 기본 구조를 함께 적용합니다. 다만 검색 순위 상승 자체를 보장하는 서비스는 아닙니다.',
  },
];

const structuredData = [
  breadcrumbJsonLd([
    { name: '홈', url: homeUrl },
    { name: '가성비 홈페이지 제작', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'ko-KR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: '가성비 홈페이지 제작',
    provider: { '@type': 'Organization', name: '바니코드' },
    areaServed: 'KR',
    description,
    url: pageUrl,
  },
  faqJsonLd(faqItems.map((item) => ({ question: item.question, answer: item.answer }))),
];
---

<BaseLayout title={title} description={description} path="affordable-homepage/" structuredData={structuredData}>
  <Header />
  <Breadcrumb items={[{ label: '홈', href: `${base}` }, { label: '가성비 홈페이지 제작' }]} />

  <main>
    <PageHero kicker="AFFORDABLE HOMEPAGE" chips={['핵심 기능 우선', '단계적 확장', '합리적인 범위 설계', '재사용 가능한 구조']}>
      <h1 slot="heading">
        가성비 홈페이지 제작,<br />
        필요한 것부터 시작합니다
      </h1>
      가성비 홈페이지 제작이란 무조건 가장 싼 가격을 뜻하지 않습니다. 지금 사업에 꼭 필요한
      기능에 예산을 집중하고, 당장 필요하지 않은 기능은 나중으로 미뤄 전체 범위를
      합리적으로 설계하는 방식입니다.
    </PageHero>

    <section class="page-band alt section-anchor" id="affordable-homepage-detail">
      <div class="bunny-process-wrap">
        <div class="bunny-process-box">

          <!-- 1. 어떤 고객에게 적합한가 -->
          <div class="bunny-section-head">
            <p class="bunny-process-label">WHO IT'S FOR</p>
            <h2 class="bunny-process-title">이런 분들께 잘 맞아요</h2>
            <p class="bunny-process-desc">
              큰 예산보다 필요한 기능을 먼저 갖추는 것이 중요한 경우에 특히 도움이 됩니다.
            </p>
          </div>

          <div class="bunny-addon-grid">
            <div class="bunny-addon">
              <strong>처음 홈페이지를 만드는 소상공인</strong>
              <p>매장이나 서비스를 처음 온라인에 알리려는 경우.</p>
            </div>
            <div class="bunny-addon">
              <strong>1인 사업자</strong>
              <p>혼자 운영하며 필요한 기능만 최소한으로 갖추고 싶은 경우.</p>
            </div>
            <div class="bunny-addon">
              <strong>신규 브랜드</strong>
              <p>브랜드를 막 시작해 초기 소개 페이지가 필요한 경우.</p>
            </div>
            <div class="bunny-addon">
              <strong>스타트업 초기 서비스</strong>
              <p>서비스 검증 단계에서 빠르게 소개 페이지가 필요한 경우.</p>
            </div>
            <div class="bunny-addon">
              <strong>행사 · 프로젝트용 사이트</strong>
              <p>정해진 기간 동안만 운영할 캠페인이나 행사 페이지.</p>
            </div>
            <div class="bunny-addon">
              <strong>적은 페이지로 정보 전달이 필요한 업체</strong>
              <p>많은 페이지보다 핵심 정보 전달에 집중하고 싶은 경우.</p>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 2. 비용이 달라지는 요소 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">COST FACTORS</p>
              <h2 class="bunny-process-title">제작 비용은 무엇에 따라 달라지나요?</h2>
              <p class="bunny-process-desc">
                홈페이지 제작에는 정해진 정가가 없습니다. 아래 요소들이 어떻게 조합되는지에
                따라 필요한 작업 범위와 비용이 달라집니다.
              </p>
            </div>

            <div class="bunny-feature-grid">
              <span>페이지 수</span>
              <span>디자인 범위</span>
              <span>반응형 여부</span>
              <span>문의 폼</span>
              <span>관리자 기능</span>
              <span>회원 기능</span>
              <span>결제 기능</span>
              <span>외부 API</span>
              <span>백엔드 연동</span>
              <span>콘텐츠 제작 여부</span>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 3. 비용을 줄이는 방법 -->
          <div class="bunny-section">
            <div class="bunny-section-head center">
              <p class="bunny-process-label">STEP BY STEP</p>
              <h2 class="bunny-process-title">비용을 줄이는 가장 확실한 방법: 단계적 확장</h2>
              <p class="bunny-process-desc">
                처음부터 모든 기능을 한 번에 만드는 대신, 지금 필요한 부분부터 시작하고
                이후 필요해졌을 때 기능을 추가하는 방식입니다.
              </p>
            </div>

            <div class="bunny-week-grid">
              <div class="bunny-week-card">
                <div class="week">STAGE 01 · 지금 시작</div>
                <h4>핵심 기능부터</h4>
                <div class="bunny-week-list">
                  <div>회사 / 서비스 소개</div>
                  <div>문의</div>
                  <div>모바일 대응</div>
                </div>
              </div>

              <div class="bunny-week-card">
                <div class="week">STAGE 02 · 필요할 때</div>
                <h4>기능은 나중에 확장</h4>
                <div class="bunny-week-list">
                  <div>관리자 기능</div>
                  <div>회원 기능</div>
                  <div>예약 기능</div>
                  <div>결제 기능</div>
                </div>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 4. 저가형과 가성비 제작의 차이 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">WHAT AFFORDABLE MEANS</p>
              <h2 class="bunny-process-title">가성비 홈페이지 제작이란?</h2>
              <p class="bunny-process-desc">
                가성비 제작의 목표는 무조건 가장 싼 가격이 아니라, 지금 사업에 필요한 기능에
                비용을 우선적으로 집중하는 것입니다.
              </p>
            </div>

            <div class="bunny-website-grid">
              <div class="bunny-option-card bunny-option-custom">
                <div class="bunny-option-badge">단순 저가형</div>
                <h3>저렴하기만 한 홈페이지</h3>
                <p class="bunny-option-eng">CHEAP ONLY</p>
                <p>가격만 낮추는 데 집중해, 필요한 기능이 빠지거나 이후 확장이 어려운 구조로 만들어지는 경우가 많습니다.</p>
                <div class="bunny-mini-flow">
                  <div>기능 우선순위 없이 축소</div>
                  <div>확장을 고려하지 않은 구조</div>
                </div>
              </div>

              <div class="bunny-option-card bunny-option-ai">
                <div class="bunny-option-badge">♡ 가성비 제작</div>
                <h3>필요한 기능에 집중한 홈페이지</h3>
                <p class="bunny-option-eng">VALUE-FOCUSED</p>
                <p>지금 필요한 기능과 나중에 추가할 기능을 구분해서, 우선순위가 높은 부분부터 제대로 만듭니다.</p>
                <div class="bunny-mini-flow">
                  <div>핵심 기능에 예산 집중</div>
                  <div>이후 확장을 고려한 구조 설계</div>
                </div>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 5. 제작 범위 예시 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">SCOPE EXAMPLES</p>
              <h2 class="bunny-process-title">제작 범위는 이렇게 나눠서 생각할 수 있어요</h2>
              <p class="bunny-process-desc">
                정확한 금액 대신, 범위를 기준으로 예시를 안내해드립니다. 실제 구성은 상담을
                통해 함께 정합니다.
              </p>
            </div>

            <div class="bunny-addon-grid">
              <div class="bunny-week-card">
                <div class="week">TYPE A</div>
                <h4>간단한 소개형 사이트</h4>
                <div class="bunny-week-list">
                  <div>메인</div>
                  <div>서비스 안내</div>
                  <div>회사 / 브랜드 소개</div>
                  <div>문의</div>
                </div>
              </div>

              <div class="bunny-week-card">
                <div class="week">TYPE B</div>
                <h4>사업용 기본 사이트</h4>
                <div class="bunny-week-list">
                  <div>여러 서비스 페이지</div>
                  <div>포트폴리오</div>
                  <div>문의</div>
                  <div>SEO 기본 설정</div>
                </div>
              </div>

              <div class="bunny-week-card">
                <div class="week">TYPE C</div>
                <h4>확장형</h4>
                <div class="bunny-week-list">
                  <div>API 연동</div>
                  <div>관리자 기능</div>
                  <div>회원 · 예약 기능</div>
                  <div>기타 맞춤 기능</div>
                </div>
              </div>
            </div>

            <p class="bunny-notice">
              ※ 위 구성은 예시이며, 실제 제작 범위와 비용은 상담을 통해 확정됩니다. 더 많은
              페이지와 기능이 필요한 프로젝트라면
              <a href={`${base}homepage/`}>홈페이지 제작 서비스</a>에서 전체 범위를 확인해보세요.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 6. FAQ -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">FAQ</p>
              <h2 class="bunny-process-title">자주 묻는 질문</h2>
              <p class="bunny-process-desc">
                가격과 제작 기간처럼 프로젝트마다 달라지는 항목은 상담을 통해 정확히 안내해드립니다.
              </p>
            </div>

            <Faq items={faqItems} />
          </div>

          <!-- FINAL CTA -->
          <div class="bunny-final">
            <p class="heart">♡ LET'S MAKE IT ♡</p>
            <h3>지금 필요한 만큼부터 시작해보세요.</h3>
            <p>
              가진 예산과 필요한 기능을 알려주시면<br />
              합리적인 제작 범위를 함께 설계해드립니다.
            </p>
            <div class="bunny-buttons">
              <button type="button" class="bunny-btn bunny-btn-price" data-open-contact-modal>✉ 가격 문의하기</button>
              <a class="bunny-btn bunny-btn-kakao" href="https://open.kakao.com/o/gfMcjbOi" target="_blank" rel="noopener">💬 카카오톡 상담</a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/structuredData';
import { canonicalUrl, internalPath } from '../../lib/url';

const pageUrl = canonicalUrl('landing-page/');
const homeUrl = canonicalUrl('');

const title = '랜딩페이지 제작 | 서비스·광고·상담 페이지 | 바니코드';
const description =
  '방문자가 문의, 신청, 상담 중 하나의 행동을 하도록 설계한 랜딩페이지 제작. 검색엔진 기본 구조를 적용하고, 지역·서비스별로 여러 페이지가 필요하면 효율적으로 확장합니다.';

const faqItems = [
  {
    question: '랜딩페이지란 무엇인가요?',
    answer:
      '랜딩페이지는 방문자가 상담, 신청, 구매 등 하나의 핵심 행동을 하도록 설계한 목적 중심의 웹페이지입니다. 여러 메뉴로 정보를 나눠 보여주는 일반 홈페이지와 달리, 한 페이지 안에서 방문 목적과 행동 유도를 연결하는 데 집중합니다.',
  },
  {
    question: '홈페이지와 랜딩페이지 중 무엇을 선택해야 하나요?',
    answer:
      '회사 소개, 여러 서비스, 오시는 길처럼 전달할 정보가 다양하다면 홈페이지가 맞고, 하나의 서비스나 캠페인을 문의·신청으로 바로 연결하고 싶다면 랜딩페이지가 더 적합합니다. 두 가지를 함께 운영하는 경우도 많습니다.',
  },
  {
    question: '지역이나 서비스별로 여러 페이지가 필요한데 가능한가요?',
    answer: '네. 하나의 디자인 템플릿을 기준으로 지역명, 서비스명 등 내용만 바꿔 여러 페이지를 효율적으로 만드는 구조를 제공합니다.',
  },
  {
    question: '검색광고(네이버, 구글 광고)용으로도 사용할 수 있나요?',
    answer: '네. 광고 유입 방문자가 바로 문의나 신청으로 이어지도록 페이지 구조와 CTA 위치를 구성할 수 있습니다.',
  },
  {
    question: '전환율이 확실히 오르나요?',
    answer:
      '페이지 구조와 CTA 배치는 방문자가 행동하기 쉽도록 설계하지만, 실제 전환율은 상품, 가격, 타겟, 광고 품질 등 페이지 외적인 요소에도 크게 좌우되므로 특정 수치의 전환율 상승을 보장하지는 않습니다.',
  },
  {
    question: '방문자 분석 도구도 연결할 수 있나요?',
    answer: '네. 필요한 범위 내에서 방문자 수, 유입 경로, 전환 이벤트를 확인할 수 있는 분석 도구를 연결할 수 있습니다.',
  },
];

const structuredData = [
  breadcrumbJsonLd([
    { name: '홈', url: homeUrl },
    { name: '랜딩페이지 제작', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'ko-KR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: '랜딩페이지 제작',
    provider: { '@type': 'Organization', name: '바니코드' },
    areaServed: 'KR',
    description,
    url: pageUrl,
  },
  faqJsonLd(faqItems.map((item) => ({ question: item.question, answer: item.answer }))),
];
---

<BaseLayout title={title} description={description} path="landing-page/" structuredData={structuredData}>
  <Header />
  <Breadcrumb items={[{ label: '홈', href: internalPath('') }, { label: '랜딩페이지 제작' }]} />

  <main>
    <PageHero kicker="LANDING PAGE" chips={['목적 중심 1 페이지', 'SEO 기본 구조', '다중 페이지 확장', '분석 도구 연동']}>
      <h1 slot="heading">
        목적이 분명한,<br />
        랜딩페이지 제작
      </h1>
      랜딩페이지는 방문자가 문의, 신청, 상담 중 하나의 행동을 하도록 설계한 목적 중심의
      페이지입니다. 검색광고나 캠페인처럼 유입 목적이 뚜렷한 경우, 여러 정보를 나열하는
      대신 하나의 목표로 방문자를 안내하는 구조가 더 효과적입니다.
    </PageHero>

    <section class="page-band alt section-anchor" id="landing-page-detail">
      <div class="bunny-process-wrap">
        <div class="bunny-process-box">

          <!-- 1. Answer-first -->
          <div class="bunny-section-head">
            <p class="bunny-process-label">WHAT IS IT</p>
            <h2 class="bunny-process-title">랜딩페이지란 무엇인가요?</h2>
            <p class="bunny-process-desc">
              랜딩페이지는 방문자가 상담, 신청, 구매 등 하나의 핵심 행동을 하도록 설계한
              목적 중심의 웹페이지입니다. 회사 소개나 여러 메뉴로 정보를 나누는 일반
              홈페이지와 달리, 하나의 페이지 안에서 방문 목적과 행동 유도(CTA)를
              바로 연결합니다.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 2. 홈페이지 vs 랜딩페이지 비교 -->
          <div class="bunny-section">
            <div class="bunny-section-head center">
              <p class="bunny-process-label">HOMEPAGE VS LANDING PAGE</p>
              <h2 class="bunny-process-title">홈페이지와 랜딩페이지, 무엇이 다른가요?</h2>
              <p class="bunny-process-desc">
                두 가지 모두 필요한 경우도 많습니다. 목적에 따라 선택하거나 함께
                운영할 수 있습니다.
              </p>
            </div>

            <div class="bunny-website-grid">
              <div class="bunny-option-card bunny-option-custom">
                <div class="bunny-option-badge">MULTI-PAGE</div>
                <h3>홈페이지</h3>
                <p class="bunny-option-eng">COMPANY / BRAND SITE</p>
                <p>회사 소개, 여러 서비스, 오시는 길 등 다양한 정보를 메뉴별로 나눠 전달합니다.</p>
                <div class="bunny-mini-flow">
                  <div>여러 메뉴 · 여러 페이지</div>
                  <div>신뢰도 · 브랜드 전달 중심</div>
                </div>
                <div class="bunny-recommend">
                  <strong>이런 경우 추천해요 ♡</strong>
                  <span>
                    전달할 정보와 서비스가 다양한 경우<br />
                    회사·브랜드 전체를 소개해야 하는 경우
                  </span>
                </div>
              </div>

              <div class="bunny-option-card bunny-option-ai">
                <div class="bunny-option-badge">♡ SINGLE GOAL</div>
                <h3>랜딩페이지</h3>
                <p class="bunny-option-eng">ONE GOAL, ONE PAGE</p>
                <p>하나의 서비스나 캠페인을 문의·신청 같은 단일 행동으로 바로 연결합니다.</p>
                <div class="bunny-mini-flow">
                  <div>단일 페이지 · 단일 목표</div>
                  <div>검색광고 · 캠페인에 적합</div>
                </div>
                <div class="bunny-recommend">
                  <strong>이런 경우 추천해요 ♡</strong>
                  <span>
                    하나의 서비스만 집중 소개하고 싶은 경우<br />
                    광고 유입을 바로 전환으로 연결하고 싶은 경우
                  </span>
                </div>
              </div>
            </div>

            <p class="bunny-notice">
              회사 전체를 소개하는 페이지가 함께 필요하다면
              <a href={internalPath('homepage/')}>홈페이지 제작 서비스</a>에서 전체 구성을 확인해보세요.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 3. 언제 필요한가 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">WHEN YOU NEED IT</p>
              <h2 class="bunny-process-title">이런 경우에 랜딩페이지가 필요해요</h2>
            </div>

            <div class="bunny-addon-grid">
              <div class="bunny-addon">
                <strong>검색광고 · 배너광고</strong>
                <p>광고 유입 방문자를 하나의 목표(문의·신청)로 바로 연결하고 싶은 경우.</p>
              </div>
              <div class="bunny-addon">
                <strong>이벤트 · 프로모션</strong>
                <p>기간이 정해진 할인, 이벤트, 오픈 소식을 알리는 경우.</p>
              </div>
              <div class="bunny-addon">
                <strong>사전 신청 · 예약</strong>
                <p>출시 전 사전 신청이나 상담 예약을 받고 싶은 경우.</p>
              </div>
              <div class="bunny-addon">
                <strong>단일 상품 · 서비스 소개</strong>
                <p>여러 서비스 중 하나를 집중적으로 소개하고 싶은 경우.</p>
              </div>
              <div class="bunny-addon">
                <strong>지역별 서비스 홍보</strong>
                <p>같은 서비스를 지역마다 다른 페이지로 홍보하고 싶은 경우.</p>
              </div>
              <div class="bunny-addon">
                <strong>상담 전환 중심 페이지</strong>
                <p>정보 전달보다 상담 신청 전환을 우선하고 싶은 경우.</p>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 4. 다중 페이지 확장 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">MULTI-PAGE EXPANSION</p>
              <h2 class="bunny-process-title">여러 페이지가 필요하다면 효율적으로 확장합니다</h2>
              <p class="bunny-process-desc">
                지역·서비스·상품처럼 같은 구조에 내용만 다른 페이지가 여러 개 필요한
                프로젝트에 특히 적합합니다.
              </p>
            </div>

            <div class="bunny-seo-points">
              <div class="bunny-seo-point">
                <strong>TEMPLATE SYSTEM</strong>
                <span>하나의 디자인 템플릿을 기준으로 지역·상품·서비스별 페이지를 확장합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>SEO 기본 설정</strong>
                <span>Title, Description, Open Graph, JSON-LD, Sitemap 등을 기본으로 구성합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>분석 도구 연동</strong>
                <span>방문자 수, 유입 경로, 전환 이벤트를 확인할 수 있는 범위 내에서 연동합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>전환 이벤트 추적</strong>
                <span>전화, 카카오톡, 문의 폼 제출 등 전환 지점을 확인할 수 있도록 구성합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>반응형 대응</strong>
                <span>광고 유입은 모바일 비중이 높으므로 모바일 화면을 우선 고려해 제작합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>필요 시 맞춤 기능</strong>
                <span>문의 폼, 신청 접수 등 필요한 기능은 <a href={internalPath('web-development/')}>홈페이지 개발</a> 범위에서 추가로 연결합니다.</span>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 5. FAQ -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">FAQ</p>
              <h2 class="bunny-process-title">자주 묻는 질문</h2>
            </div>

            <Faq items={faqItems} />
          </div>

          <!-- FINAL CTA -->
          <div class="bunny-final">
            <p class="heart">♡ LET'S MAKE IT ♡</p>
            <h3>어떤 목적의 페이지가 필요한지 알려주세요.</h3>
            <p>
              광고, 이벤트, 상담 신청 등 목적을 알려주시면<br />
              그에 맞는 랜딩페이지 구조를 제안해드립니다.
            </p>
            <div class="bunny-buttons">
              <button type="button" class="bunny-btn bunny-btn-price" data-open-contact-modal>✉ 가격 문의하기</button>
              <a class="bunny-btn bunny-btn-kakao" href="https://open.kakao.com/o/gfMcjbOi" target="_blank" rel="noopener">💬 카카오톡 상담</a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

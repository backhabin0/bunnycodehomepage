---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/structuredData';

const base = import.meta.env.BASE_URL; // '/bunnycode/'
const siteOrigin = import.meta.env.SITE ?? 'https://hanapage.co.kr';
const pageUrl = new URL('homepage/', `${siteOrigin}${base}`).href;
const homeUrl = new URL('', `${siteOrigin}${base}`).href;

const title = '홈페이지 제작 | 반응형 웹·SEO·맞춤 개발 | 버니코드';
const description =
  '기업, 브랜드, 소상공인을 위한 홈페이지 제작. 반응형 웹, 랜딩페이지, SEO 기본 구조와 필요 시 맞춤 기능 개발까지 프로젝트 범위에 맞춰 제작합니다.';

const faqItems = [
  {
    question: '홈페이지 제작 기간은 얼마나 걸리나요?',
    answer:
      '페이지 수, 디자인 범위, 추가 기능 여부에 따라 달라집니다. 정확한 일정은 상담 시 요구사항을 확인한 뒤 안내해드립니다.',
  },
  {
    question: '모바일 홈페이지도 같이 제작되나요?',
    answer: '네. 별도의 모바일 전용 사이트를 따로 만드는 방식이 아니라, PC와 모바일 모두에서 자연스럽게 보이는 반응형 구조로 제작합니다.',
  },
  {
    question: '도메인이 없어도 제작할 수 있나요?',
    answer: '가능합니다. 제작을 먼저 진행하고, 도메인과 호스팅은 준비되는 시점에 맞춰 연결할 수 있습니다.',
  },
  {
    question: '기존 홈페이지를 리뉴얼할 수도 있나요?',
    answer: '네. 기존 화면 구조와 콘텐츠를 확인한 뒤, 유지할 부분과 새로 만들 부분을 나눠서 리뉴얼을 진행할 수 있습니다.',
  },
  {
    question: '홈페이지 제작 후에도 수정할 수 있나요?',
    answer: '완성 이후 텍스트·이미지 등 콘텐츠 수정이 필요하면 별도로 문의해 진행할 수 있습니다. 수정 범위에 따라 협의가 필요합니다.',
  },
  {
    question: 'SEO 작업도 함께 가능한가요?',
    answer:
      '네. 메타데이터, Open Graph, sitemap 등 검색엔진이 페이지를 이해하기 좋은 기본 구조를 함께 구성합니다. 다만 특정 키워드의 검색 순위 상승을 보장하지는 않습니다.',
  },
  {
    question: '백엔드 기능을 추가할 수 있나요?',
    answer: '네. 회원가입, 예약, 문의 접수 등 서버가 필요한 기능은 프로젝트 범위에 맞춰 별도로 개발해 연결할 수 있습니다.',
  },
];

const structuredData = [
  breadcrumbJsonLd([
    { name: '홈', url: homeUrl },
    { name: '홈페이지 제작', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'ko-KR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: '홈페이지 제작',
    provider: { '@type': 'Organization', name: '버니코드' },
    areaServed: 'KR',
    description,
    url: pageUrl,
  },
  faqJsonLd(faqItems.map((item) => ({ question: item.question, answer: item.answer }))),
];
---

<BaseLayout title={title} description={description} path="homepage/" structuredData={structuredData}>
  <Header />
  <Breadcrumb items={[{ label: '홈', href: `${base}` }, { label: '홈페이지 제작' }]} />

  <main>
    <PageHero kicker="HOMEPAGE" chips={['반응형 웹', 'SEO 기본 구조', '랜딩페이지 연계', '맞춤 기능 개발']}>
      <h1 slot="heading">
        사업에 맞는 홈페이지,<br />
        필요한 기능만 제대로 만듭니다
      </h1>
      가입 폼이나 결제 기능이 필요 없다면 굳이 넣지 않고, 예약이나 회원 기능이 필요하다면
      백엔드까지 연결합니다. 회사·브랜드 소개부터 캠페인용 랜딩페이지까지, 목적에 맞는
      구조로 홈페이지를 제작합니다.
    </PageHero>

    <section class="page-band alt section-anchor" id="homepage-detail">
      <div class="bunny-process-wrap">
        <div class="bunny-process-box">

          <!-- 1. 어떤 홈페이지를 제작할 수 있는지 -->
          <div class="bunny-section-head">
            <p class="bunny-process-label">WHAT WE BUILD</p>
            <h2 class="bunny-process-title">어떤 홈페이지를 제작할 수 있나요?</h2>
            <p class="bunny-process-desc">
              업종과 목적에 따라 필요한 페이지 구성이 다르기 때문에, 아래 유형을 기준으로
              프로젝트에 맞는 구조를 제안해드립니다.
            </p>
          </div>

          <div class="bunny-addon-grid">
            <div class="bunny-addon">
              <strong>회사 홈페이지</strong>
              <p>기업 소개, 사업 영역, 연혁, 오시는 길 등 신뢰도가 중요한 기업용 홈페이지.</p>
            </div>
            <div class="bunny-addon">
              <strong>브랜드 홈페이지</strong>
              <p>브랜드 톤앤매너와 스토리를 전달하는 데 집중한 홈페이지.</p>
            </div>
            <div class="bunny-addon">
              <strong>소상공인 홈페이지</strong>
              <p>매장 정보, 서비스 안내, 문의·예약 연결에 집중한 실용적인 홈페이지.</p>
            </div>
            <div class="bunny-addon">
              <strong>서비스 소개 사이트</strong>
              <p>하나의 서비스나 제품을 자세히 소개하고 문의로 연결하는 사이트.</p>
            </div>
            <div class="bunny-addon">
              <strong>이벤트 · 캠페인 페이지</strong>
              <p>기간이 정해진 행사나 프로모션을 안내하는 단기 운영용 페이지.</p>
            </div>
            <div class="bunny-addon">
              <strong>랜딩페이지</strong>
              <p>하나의 목표(문의·신청·구매)로 방문자를 유도하는 단일 페이지.</p>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 2. 홈페이지 제작 방식 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">HOW IT'S BUILT</p>
              <h2 class="bunny-process-title">홈페이지는 이런 순서로 만들어져요</h2>
              <p class="bunny-process-desc">
                디자인만 예쁘게 만드는 것이 아니라, 실제로 방문자가 사용하고 검색엔진이
                읽을 수 있는 구조까지 함께 진행합니다.
              </p>
            </div>

            <div class="bunny-flow-auto">
              <div class="bunny-common-step">
                <div class="bunny-common-num">01</div>
                <strong>기획</strong>
                <span>필요한 페이지와 콘텐츠 구성을 정리합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">02</div>
                <strong>디자인</strong>
                <span>브랜드 분위기에 맞는 화면 디자인을 만듭니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">03</div>
                <strong>개발</strong>
                <span>디자인을 실제 동작하는 웹페이지로 구현합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">04</div>
                <strong>모바일 최적화</strong>
                <span>PC와 모바일 모두에서 자연스럽게 보이도록 다듬습니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">05</div>
                <strong>SEO 기본 설정</strong>
                <span>검색엔진이 페이지를 이해할 수 있는 기본 구조를 적용합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">06</div>
                <strong>배포</strong>
                <span>최종 검수 후 실제 서비스 주소로 배포합니다.</span>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 3. 기본 제작과 맞춤 제작 차이 -->
          <div class="bunny-section">
            <div class="bunny-section-head center">
              <p class="bunny-process-label">BASIC VS CUSTOM</p>
              <h2 class="bunny-process-title">기본 제작과 맞춤 제작, 무엇이 다른가요?</h2>
              <p class="bunny-process-desc">
                필요한 기능과 예산에 따라 두 가지 방식 중에서 선택하거나, 기본 구성으로
                시작해 이후 맞춤 기능을 추가할 수 있습니다.
              </p>
            </div>

            <div class="bunny-website-grid">
              <div class="bunny-option-card bunny-option-ai">
                <div class="bunny-option-badge">♡ QUICK & VALUE</div>
                <h3>기본형</h3>
                <p class="bunny-option-eng">STANDARD BUILD</p>
                <p>
                  자주 사용되는 구조를 기반으로 필요한 페이지 위주로 빠르게 제작합니다.
                  소개, 서비스, 문의 등 핵심 구성에 집중합니다.
                </p>
                <div class="bunny-mini-flow">
                  <div>필요한 페이지 위주로 구성</div>
                  <div>반응형 · SEO 기본 설정 포함</div>
                  <div>상대적으로 빠른 제작</div>
                </div>
                <div class="bunny-recommend">
                  <strong>이런 경우 추천해요 ♡</strong>
                  <span>
                    처음 홈페이지를 만드는 경우<br />
                    합리적인 범위로 빠르게 시작하고 싶은 경우
                  </span>
                </div>
              </div>

              <div class="bunny-option-card bunny-option-custom">
                <div class="bunny-option-badge">CUSTOM BUILD</div>
                <h3>맞춤형</h3>
                <p class="bunny-option-eng">TAILORED BUILD</p>
                <p>
                  브랜드 개성에 맞춘 디자인과, 회원·예약·결제 등 필요한 백엔드 기능까지
                  포함해 처음부터 맞춤으로 설계합니다.
                </p>
                <div class="bunny-mini-flow">
                  <div>브랜드 맞춤 디자인</div>
                  <div>회원 · 예약 · 결제 등 기능 개발</div>
                  <div>확장 가능한 구조 설계</div>
                </div>
                <div class="bunny-recommend">
                  <strong>이런 경우 추천해요 ♡</strong>
                  <span>
                    브랜드 개성이 중요한 경우<br />
                    서버 기능이 필요한 서비스형 홈페이지인 경우
                  </span>
                </div>
              </div>
            </div>

            <p class="bunny-notice">
              예산이 가장 중요한 기준이라면,
              <a href={`${base}affordable-homepage/`}>가성비 홈페이지 제작 방식</a>에서
              필요한 기능부터 단계적으로 시작하는 방법을 확인해보세요.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 4. 기술적으로 무엇을 제공하는가 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">WHAT'S INCLUDED</p>
              <h2 class="bunny-process-title">기술적으로 이런 부분까지 챙깁니다</h2>
              <p class="bunny-process-desc">
                "SEO 최적화"라는 말로 뭉뚱그리지 않고, 실제로 어떤 작업을 하는지 구체적으로
                안내해드립니다.
              </p>
            </div>

            <div class="bunny-seo-points">
              <div class="bunny-seo-point">
                <strong>모바일 반응형</strong>
                <span>PC, 태블릿, 모바일 화면 크기에 맞춰 레이아웃이 자연스럽게 조정됩니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>검색엔진 친화적 구조</strong>
                <span>header, nav, main, section 등 의미에 맞는 HTML 태그로 구조를 작성합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>기본 메타데이터 · Open Graph</strong>
                <span>title, description, 공유 시 보이는 미리보기 정보를 기본으로 설정합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>Sitemap</strong>
                <span>검색엔진이 페이지를 찾기 쉽도록 sitemap.xml을 구성합니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>이미지 최적화 · 성능</strong>
                <span>이미지 크기와 로딩 방식을 조정해 불필요한 로딩 지연을 줄입니다.</span>
              </div>
              <div class="bunny-seo-point">
                <strong>필요 시 백엔드 연동</strong>
                <span>회원, 예약, 문의 접수 등 서버 기능이 필요하면 별도로 연결합니다.</span>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 5. 홈페이지 제작 과정 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">OUR PROCESS</p>
              <h2 class="bunny-process-title">상담부터 배포까지, 제작 과정 안내</h2>
              <p class="bunny-process-desc">
                프로젝트 전체의 진행 흐름은
                <a href={`${base}#process`}>메인 페이지 진행 방식</a>에서도 확인하실 수 있습니다.
              </p>
            </div>

            <div class="bunny-flow-auto">
              <div class="bunny-common-step">
                <div class="bunny-common-num">01</div>
                <strong>상담</strong>
                <span>원하는 홈페이지와 필요한 기능을 전달해주세요.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">02</div>
                <strong>요구사항 정리</strong>
                <span>필요한 페이지와 기능을 구체적으로 정리합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">03</div>
                <strong>구조 설계</strong>
                <span>페이지 구성과 정보 흐름을 설계합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">04</div>
                <strong>디자인</strong>
                <span>브랜드에 맞는 화면 디자인을 진행합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">05</div>
                <strong>개발</strong>
                <span>디자인을 실제 홈페이지로 구현합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">06</div>
                <strong>검수</strong>
                <span>기능과 화면을 함께 확인하고 수정합니다.</span>
              </div>
              <div class="bunny-common-step">
                <div class="bunny-common-num">07</div>
                <strong>배포</strong>
                <span>최종 확인 후 실제 서비스로 배포합니다.</span>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 6. FAQ -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">FAQ</p>
              <h2 class="bunny-process-title">자주 묻는 질문</h2>
              <p class="bunny-process-desc">
                제작 기간, 비용처럼 프로젝트마다 달라지는 항목은 상담을 통해 정확히 안내해드립니다.
              </p>
            </div>

            <Faq items={faqItems} />
          </div>

          <!-- FINAL CTA -->
          <div class="bunny-final">
            <p class="heart">♡ LET'S MAKE IT ♡</p>
            <h3>어떤 구성이 맞는지 모르셔도 괜찮아요.</h3>
            <p>
              필요한 페이지와 기능만 알려주세요.<br />
              프로젝트에 맞는 제작 범위와 방향을 안내해드립니다.
            </p>
            <div class="bunny-buttons">
              <button type="button" class="bunny-btn bunny-btn-price" data-open-contact-modal>✉ 가격 문의하기</button>
              <a class="bunny-btn bunny-btn-kakao" href="https://open.kakao.com/o/gfMcjbOi" target="_blank" rel="noopener">💬 카카오톡 상담</a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

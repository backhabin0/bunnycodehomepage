---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/structuredData';
import { canonicalUrl, internalPath } from '../../lib/url';

const pageUrl = canonicalUrl('app-development/');
const homeUrl = canonicalUrl('');

const title = '앱 개발 | Flutter 기반 모바일 앱 제작 | 바니코드';
const description =
  'Flutter로 Android와 iOS 앱을 함께 제작합니다. 기능 10개 이내 개인 맞춤 앱부터 회원·예약·결제가 필요한 기업·상인용 비즈니스 앱까지, 필요한 규모에 맞춰 개발합니다.';

const faqItems = [
  {
    question: '앱 개발에서 처음부터 필요한 기능과 나중에 추가할 기능은 어떻게 나누나요?',
    answer:
      '로그인, 핵심 화면, 데이터 저장처럼 서비스가 성립하기 위해 반드시 있어야 하는 기능을 먼저 만들고, 알림, 통계, 커뮤니티처럼 사용자가 늘어난 뒤에 필요해지는 기능은 이후 단계로 미루는 방식을 권장합니다. 처음부터 모든 기능을 넣으면 개발 기간과 비용이 함께 늘어나기 때문입니다.',
  },
  {
    question: '웹과 앱 중 무엇부터 만들어야 할까요?',
    answer:
      '정보 전달이나 문의가 목적이라면 검색에도 노출되는 홈페이지나 랜딩페이지가 먼저 필요한 경우가 많고, 알림이나 반복 사용, 오프라인 기능이 중요하다면 앱이 더 적합합니다. 서비스 성격에 따라 웹과 앱을 함께 운영하는 경우도 많습니다.',
  },
  {
    question: '개인 맞춤 앱 20,000원 상품은 무엇인가요?',
    answer:
      '일정 등록, 할 일 체크, 운동·식단 기록 같은 개인용 기능을 최대 10개까지 담는 간단한 개인 사용 목적의 앱 제작 상품입니다. 서버 구축, 결제, 회원 시스템, 외부 API 연동, 앱스토어 등록처럼 개인 사용 범위를 넘는 기능이 필요하면 별도 상담을 통해 안내해드립니다.',
  },
  {
    question: 'Android와 iOS를 각각 따로 개발해야 하나요?',
    answer: '아니요. Flutter로 개발하면 하나의 코드로 Android와 iOS 앱을 함께 제작할 수 있습니다.',
  },
  {
    question: '앱스토어 등록도 도와주나요?',
    answer: '앱스토어·플레이스토어 등록 준비까지 개발 범위에 포함할 수 있습니다. 정확한 범위는 상담 시 확인합니다.',
  },
  {
    question: '기존 홈페이지와 데이터를 연동할 수 있나요?',
    answer: '네. 기존 홈페이지나 백엔드가 있다면 같은 데이터베이스나 API를 앱에서도 사용하도록 연동할 수 있습니다.',
  },
  {
    question: '회원 기능이 있는 서비스형 앱도 제작하나요?',
    answer: '네. 회원가입, 로그인, 예약, 주문·결제, 커뮤니티 등이 필요한 기업·상인용 비즈니스 앱은 상담 후 견적으로 진행합니다.',
  },
];

const structuredData = [
  breadcrumbJsonLd([
    { name: '홈', url: homeUrl },
    { name: '앱 개발', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'ko-KR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: '앱 개발',
    provider: { '@type': 'Organization', name: '바니코드' },
    areaServed: 'KR',
    description,
    url: pageUrl,
  },
  faqJsonLd(faqItems.map((item) => ({ question: item.question, answer: item.answer }))),
];
---

<BaseLayout title={title} description={description} path="app-development/" structuredData={structuredData}>
  <Header />
  <Breadcrumb items={[{ label: '홈', href: internalPath('') }, { label: '앱 개발' }]} />

  <main>
    <PageHero kicker="APP DEVELOPMENT" chips={['Flutter', 'Android · iOS', 'Firebase · Supabase', '단계적 기능 확장']}>
      <h1 slot="heading">
        아이디어를 실제 서비스로 만드는,<br />
        앱 개발
      </h1>
      Flutter를 기반으로 Android와 iOS 앱을 함께 제작합니다. 간단한 개인용 앱부터 회원,
      예약, 결제가 필요한 기업·상인용 비즈니스 앱까지, 지금 필요한 규모에 맞춰 개발합니다.
    </PageHero>

    <section class="page-band alt section-anchor" id="app-development-detail">
      <div class="bunny-process-wrap">
        <div class="bunny-process-box">

          <!-- 1. 두 가지 방식 -->
          <div class="bunny-section-head center">
            <p class="bunny-process-label">TWO WAYS TO BUILD</p>
            <h2 class="bunny-process-title">필요한 규모에 따라 두 가지 방식으로 제작합니다</h2>
          </div>

          <div class="bunny-app-grid">
            <div class="bunny-app-card bunny-app-personal">
              <div class="bunny-app-badge">♡ 가성비 추천</div>
              <h3>개인 맞춤 앱</h3>
              <p class="bunny-app-eng">PERSONAL APP</p>
              <p>내가 직접 사용할 간단하고 실용적인 앱을 원하는 기능에 맞춰 제작합니다.</p>
              <div class="bunny-app-price">
                <small>기능 최대 10개까지</small>
                <strong>20,000원<span> / 앱 1개</span></strong>
              </div>
              <div class="bunny-feature-grid">
                <span>일정 등록</span>
                <span>할 일 체크</span>
                <span>알림</span>
                <span>기록 저장</span>
                <span>운동 기록</span>
                <span>식단 기록</span>
                <span>몸무게 기록</span>
                <span>사진 첨부</span>
                <span>간단 통계</span>
                <span>개인 설정</span>
              </div>
              <div class="bunny-app-example">
                <strong>이런 앱을 만들 수 있어요</strong>
                <div class="bunny-app-example-tags">
                  <span>스케줄 앱</span>
                  <span>운동 기록</span>
                  <span>식단 기록</span>
                  <span>공부 기록</span>
                  <span>습관 관리</span>
                  <span>가계부</span>
                </div>
              </div>
            </div>

            <div class="bunny-app-card bunny-app-business">
              <div class="bunny-app-badge">BUSINESS</div>
              <h3>기업 · 상인용 앱</h3>
              <p class="bunny-app-eng">BUSINESS APP</p>
              <p>고객이 실제로 사용하는 앱, 매장 운영 앱, 브랜드 앱, 기업 내부 서비스 등 비즈니스 목적에 맞춰 개발합니다.</p>
              <div class="bunny-app-price consult">
                <small>기능 및 규모에 따라</small>
                <strong>상담 후 견적</strong>
              </div>
              <div class="bunny-feature-grid">
                <span>회원가입</span>
                <span>로그인</span>
                <span>예약</span>
                <span>주문 / 결제</span>
                <span>고객 관리</span>
                <span>관리자 기능</span>
                <span>Push 알림</span>
                <span>커뮤니티</span>
                <span>통계</span>
                <span>API 연동</span>
              </div>
              <div class="bunny-app-example">
                <strong>이런 프로젝트에 적합해요</strong>
                <div class="bunny-app-example-tags">
                  <span>매장 예약 앱</span>
                  <span>쇼핑 앱</span>
                  <span>커뮤니티</span>
                  <span>기업 내부 앱</span>
                  <span>고객 관리</span>
                  <span>브랜드 앱</span>
                </div>
              </div>
            </div>
          </div>

          <p class="bunny-notice">
            ※ 개인 맞춤 앱 20,000원 상품은 간단한 개인 사용 목적의 앱 기준입니다. 서버 구축,
            결제, 회원 시스템, 외부 API 연동, 앱스토어 등록 등 추가 개발이 필요한 기능은
            별도 상담이 필요할 수 있습니다.
          </p>

          <div class="bunny-divider"></div>

          <!-- 2. Answer-first: 처음 vs 나중 기능 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">FIRST VS LATER</p>
              <h2 class="bunny-process-title">앱 개발에서 처음부터 필요한 기능, 나중에 추가할 기능</h2>
              <p class="bunny-process-desc">
                모든 기능을 처음부터 넣기보다, 서비스가 성립하기 위해 꼭 필요한 기능부터
                만들고 이후 사용자 반응을 보며 기능을 확장하는 방식을 권장합니다.
              </p>
            </div>

            <div class="bunny-week-grid">
              <div class="bunny-week-card">
                <div class="week">STEP 01 · 처음부터 필요</div>
                <h4>핵심 기능</h4>
                <div class="bunny-week-list">
                  <div>로그인 / 기본 화면</div>
                  <div>핵심 데이터 저장</div>
                  <div>필수 알림</div>
                </div>
              </div>
              <div class="bunny-week-card">
                <div class="week">STEP 02 · 필요해졌을 때</div>
                <h4>확장 기능</h4>
                <div class="bunny-week-list">
                  <div>결제 / 구독</div>
                  <div>커뮤니티</div>
                  <div>상세 통계</div>
                  <div>Push 알림 고도화</div>
                </div>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 3. 웹 vs 앱 -->
          <div class="bunny-section">
            <div class="bunny-section-head center">
              <p class="bunny-process-label">WEB VS APP</p>
              <h2 class="bunny-process-title">웹과 앱, 무엇부터 만들어야 할까요?</h2>
              <p class="bunny-process-desc">
                서비스 목적에 따라 먼저 만들어야 하는 것이 다릅니다. 함께 운영하는 경우도
                많습니다.
              </p>
            </div>

            <div class="bunny-website-grid">
              <div class="bunny-option-card bunny-option-custom">
                <div class="bunny-option-badge">SEARCH & INFO</div>
                <h3>홈페이지 · 랜딩페이지</h3>
                <p class="bunny-option-eng">WEB FIRST</p>
                <p>검색 유입, 정보 전달, 문의 접수가 중심이라면 웹이 먼저 필요한 경우가 많습니다.</p>
                <div class="bunny-recommend">
                  <strong>이런 경우 추천해요 ♡</strong>
                  <span>
                    검색으로 서비스를 알려야 하는 경우<br />
                    설치 없이 바로 접근해야 하는 경우
                  </span>
                </div>
              </div>
              <div class="bunny-option-card bunny-option-ai">
                <div class="bunny-option-badge">♡ REPEAT USE</div>
                <h3>앱</h3>
                <p class="bunny-option-eng">APP FIRST</p>
                <p>알림, 반복 사용, 오프라인 기능이 중요하다면 앱이 더 적합합니다.</p>
                <div class="bunny-recommend">
                  <strong>이런 경우 추천해요 ♡</strong>
                  <span>
                    사용자가 자주, 반복해서 써야 하는 경우<br />
                    Push 알림이 핵심인 서비스인 경우
                  </span>
                </div>
              </div>
            </div>

            <p class="bunny-notice">
              웹으로 먼저 서비스를 알리고 싶다면
              <a href={internalPath('homepage/')}>홈페이지 제작</a> 또는
              <a href={internalPath('landing-page/')}>랜딩페이지 제작</a>을 함께 확인해보세요.
              앱과 연동되는 관리자 페이지나 서버 기능이 필요하다면
              <a href={internalPath('web-development/')}>홈페이지 개발</a> 서비스에서 연결할 수 있습니다.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 4. 제작 과정 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">OUR PROCESS</p>
              <h2 class="bunny-process-title">앱 제작은 이렇게 진행돼요</h2>
            </div>

            <div class="bunny-app-flow">
              <div class="bunny-app-flow-row">
                <div class="bunny-app-step">
                  <small>STEP 01</small>
                  <strong>문의</strong>
                  <span>원하는 앱과 기능 전달</span>
                </div>
                <div class="bunny-app-step">
                  <small>STEP 02</small>
                  <strong>기능 정리</strong>
                  <span>화면과 기능 구조 설계</span>
                </div>
                <div class="bunny-app-step">
                  <small>STEP 03</small>
                  <strong>Flutter 개발</strong>
                  <span>앱 화면과 기능 제작</span>
                </div>
                <div class="bunny-app-step">
                  <small>STEP 04</small>
                  <strong>테스트</strong>
                  <span>실제 기기에서 기능 확인</span>
                </div>
                <div class="bunny-app-step">
                  <small>STEP 05</small>
                  <strong>전달</strong>
                  <span>최종 확인 후 결과물 전달</span>
                </div>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 5. FAQ -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">FAQ</p>
              <h2 class="bunny-process-title">자주 묻는 질문</h2>
            </div>

            <Faq items={faqItems} />
          </div>

          <!-- FINAL CTA -->
          <div class="bunny-final">
            <p class="heart">♡ LET'S MAKE IT ♡</p>
            <h3>어떤 방식이 맞는지 모르셔도 괜찮아요.</h3>
            <p>
              만들고 싶은 앱과 예산만 알려주세요.<br />
              개인용인지 비즈니스용인지에 맞춰 안내해드립니다.
            </p>
            <div class="bunny-buttons">
              <button type="button" class="bunny-btn bunny-btn-price" data-open-contact-modal>✉ 가격 문의하기</button>
              <a class="bunny-btn bunny-btn-kakao" href="https://open.kakao.com/o/gfMcjbOi" target="_blank" rel="noopener">💬 카카오톡 상담</a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

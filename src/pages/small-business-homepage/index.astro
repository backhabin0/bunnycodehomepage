---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/structuredData';
import { canonicalUrl, internalPath } from '../../lib/url';

const pageUrl = canonicalUrl('small-business-homepage/');
const homeUrl = canonicalUrl('');

const title = '소상공인 홈페이지 제작 | 매장·서비스·문의에 맞춘 웹사이트 | 바니코드';
const description =
  '소상공인과 1인 사업자를 위한 홈페이지 제작. 매장·서비스 소개, 모바일 대응, 전화·카카오 상담, 문의폼 등 필요한 기능부터 구성하고 사업 규모에 맞춰 확장할 수 있습니다.';

const faqItems = [
  {
    question: '소상공인 홈페이지는 몇 페이지가 필요한가요?',
    answer:
      '업종과 전달할 정보량에 따라 다르지만, 소개·서비스 안내·문의 정도만으로도 충분한 경우가 많습니다. 페이지 수보다 방문자가 필요한 정보를 빠르게 찾을 수 있는지가 더 중요합니다.',
  },
  {
    question: '네이버 블로그나 인스타그램이 있는데 홈페이지도 필요한가요?',
    answer:
      'SNS는 소식을 자주 알리고 소통하는 데 강점이 있고, 홈페이지는 매장 정보·서비스·가격처럼 항상 고정적으로 보여줘야 하는 정보를 정리해 보여주는 데 강점이 있습니다. 목적이 다르므로 SNS를 유지하면서 홈페이지를 함께 운영하는 경우가 많습니다.',
  },
  {
    question: '한 페이지짜리 홈페이지도 가능한가요?',
    answer: '네. 소개, 서비스, 문의 정도만 필요하다면 한 페이지 구성으로도 충분히 제작할 수 있습니다.',
  },
  {
    question: '전화나 카카오톡 상담 버튼을 넣을 수 있나요?',
    answer: '네. 방문자가 바로 연락할 수 있도록 전화 연결, 카카오톡 상담, 문의폼 등 원하는 상담 방식을 조합해 넣을 수 있습니다.',
  },
  {
    question: '나중에 예약 기능을 추가할 수 있나요?',
    answer: '네. 처음에는 소개와 문의 중심으로 제작하고, 예약이 실제로 필요해졌을 때 예약 기능을 추가로 개발해 연결할 수 있습니다.',
  },
  {
    question: '도메인이 없어도 제작할 수 있나요?',
    answer: '가능합니다. 제작을 먼저 진행하고, 도메인과 호스팅은 준비되는 시점에 맞춰 연결할 수 있습니다.',
  },
  {
    question: '모바일에서도 잘 보이나요?',
    answer: '네. 소상공인 홈페이지는 특히 모바일로 찾아보는 방문자 비중이 높기 때문에, PC와 모바일 모두에서 자연스럽게 보이는 반응형 구조로 제작합니다.',
  },
  {
    question: 'SEO 기본 설정도 포함할 수 있나요?',
    answer:
      '네. 메타데이터, Open Graph, sitemap 등 검색엔진이 페이지를 이해하기 좋은 기본 구조를 함께 구성합니다. 다만 특정 지역·업종 검색어의 순위 상승을 보장하지는 않습니다.',
  },
];

const structuredData = [
  breadcrumbJsonLd([
    { name: '홈', url: homeUrl },
    { name: '소상공인 홈페이지 제작', url: pageUrl },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: pageUrl,
    inLanguage: 'ko-KR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: '소상공인 홈페이지 제작',
    provider: { '@type': 'Organization', name: '바니코드' },
    areaServed: 'KR',
    description,
    url: pageUrl,
  },
  faqJsonLd(faqItems.map((item) => ({ question: item.question, answer: item.answer }))),
];
---

<BaseLayout title={title} description={description} path="small-business-homepage/" structuredData={structuredData}>
  <Header />
  <Breadcrumb items={[{ label: '홈', href: internalPath('') }, { label: '소상공인 홈페이지 제작' }]} />

  <main>
    <PageHero kicker="SMALL BUSINESS HOMEPAGE" chips={['매장 · 서비스 소개', '전화 · 카카오 상담', '문의폼', '단계적 확장']}>
      <h1 slot="heading">
        소상공인 홈페이지 제작,<br />
        필요한 정보와 문의 기능부터 시작하세요
      </h1>
      바니코드는 소상공인과 1인 사업자를 위한 홈페이지를 제작합니다. 매장·서비스 소개,
      모바일 대응, 전화·카카오톡 상담, 문의폼처럼 지금 당장 필요한 기능부터 구성하고,
      사업이 커지면 예약이나 관리자 기능을 단계적으로 추가할 수 있습니다.
    </PageHero>

    <section class="page-band alt section-anchor" id="small-business-homepage-detail">
      <div class="bunny-process-wrap">
        <div class="bunny-process-box">

          <!-- 1. Answer-first -->
          <div class="bunny-section-head">
            <p class="bunny-process-label">WHAT MATTERS MOST</p>
            <h2 class="bunny-process-title">소상공인 홈페이지는 무엇이 중요한가요?</h2>
            <p class="bunny-process-desc">
              소상공인 홈페이지는 많은 기능보다 고객이 필요한 정보를 빠르게 확인하고
              전화·문의·예약 같은 행동으로 이어질 수 있는 구조가 중요합니다. 화려한
              디자인이나 많은 페이지 수보다, 방문자가 원하는 정보(무엇을 하는 곳인지,
              어디에 있는지, 어떻게 연락하는지)를 첫 화면 근처에서 바로 찾을 수 있는지가
              실제 문의로 이어지는지를 결정합니다.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 2. 꼭 필요한 페이지 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">MUST-HAVE PAGES</p>
              <h2 class="bunny-process-title">소상공인 홈페이지에 꼭 필요한 페이지</h2>
              <p class="bunny-process-desc">
                아래는 일반적으로 많이 쓰이는 구성이며, 실제 업종과 운영 방식에 따라
                필요한 페이지는 달라질 수 있습니다.
              </p>
            </div>

            <div class="bunny-addon-grid">
              <div class="bunny-addon">
                <strong>사업 / 매장 소개</strong>
                <p>무엇을 하는 곳인지, 어떤 특징이 있는지 첫 화면에서 바로 전달합니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>서비스 또는 상품 안내</strong>
                <p>제공하는 서비스나 상품 구성을 정리해 보여줍니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>가격 또는 견적 안내</strong>
                <p>정확한 가격 공개가 어렵다면 가격대나 견적 방식만 안내할 수도 있습니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>위치 / 영업 정보</strong>
                <p>오시는 길, 영업시간, 주차 안내 등 방문에 필요한 정보를 정리합니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>문의 / 상담</strong>
                <p>전화, 카카오톡, 문의폼 중 편한 방식으로 바로 연락할 수 있게 합니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>자주 묻는 질문</strong>
                <p>상담 전에 자주 나오는 질문에 미리 답해 문의 부담을 줄입니다.</p>
              </div>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 3. 관리자 기능 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">ADMIN FEATURE</p>
              <h2 class="bunny-process-title">처음부터 관리자 기능이 필요한가요?</h2>
              <p class="bunny-process-desc">
                아니요. 대부분의 소상공인 홈페이지는 처음에는 관리자 기능 없이 시작해도
                충분합니다.
              </p>
            </div>

            <div class="bunny-website-grid">
              <div class="bunny-option-card bunny-option-ai">
                <div class="bunny-option-badge">♡ 대부분 이 경우</div>
                <h3>필요하지 않은 경우</h3>
                <p class="bunny-option-eng">NO ADMIN NEEDED</p>
                <p>가격이나 안내 문구가 자주 바뀌지 않고, 문의 건수가 많지 않은 경우.</p>
                <div class="bunny-mini-flow">
                  <div>소개 · 서비스 안내 위주</div>
                  <div>수정이 필요하면 별도 문의로 반영</div>
                </div>
              </div>

              <div class="bunny-option-card bunny-option-custom">
                <div class="bunny-option-badge">CASE BY CASE</div>
                <h3>필요해지는 경우</h3>
                <p class="bunny-option-eng">ADMIN LATER</p>
                <p>메뉴·상품이 자주 바뀌거나, 예약·신청 내역을 직접 확인·관리해야 하는 경우.</p>
                <div class="bunny-mini-flow">
                  <div>콘텐츠 직접 수정 필요</div>
                  <div>예약 · 신청 내역 관리 필요</div>
                </div>
              </div>
            </div>

            <p class="bunny-notice">
              어떤 경우든 처음부터 관리자 기능을 넣기보다, 필요해진 시점에 추가하는 방식이
              비용 면에서 더 합리적입니다. 기능 개발 범위는
              <a href={internalPath('web-development/')}>홈페이지 개발 서비스</a>에서 확인할 수 있습니다.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 4. 비용을 줄이려면 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">REDUCE COST</p>
              <h2 class="bunny-process-title">홈페이지 제작 비용을 줄이려면?</h2>
              <p class="bunny-process-desc">
                가장 싼 업체를 찾는 것보다, 아래 방법으로 필요한 범위를 명확히 하는 것이
                비용을 줄이는 더 확실한 방법입니다.
              </p>
            </div>

            <div class="bunny-addon-grid">
              <div class="bunny-addon">
                <strong>필요한 페이지부터 시작</strong>
                <p>모든 페이지를 한 번에 만들기보다 지금 꼭 필요한 페이지부터 제작합니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>처음부터 필요 없는 기능 제외</strong>
                <p>회원, 결제처럼 당장 쓰지 않을 기능은 처음 범위에서 빼둡니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>1차 / 2차 개발 분리</strong>
                <p>핵심 기능으로 먼저 오픈하고, 확장 기능은 이후 단계로 나눕니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>사진 · 텍스트 자료 준비</strong>
                <p>사용할 사진과 소개 문구를 미리 준비하면 제작 기간과 수정 범위가 줄어듭니다.</p>
              </div>
              <div class="bunny-addon">
                <strong>관리자 기능 필요 여부 판단</strong>
                <p>직접 관리해야 할 콘텐츠가 실제로 있는지 먼저 확인한 뒤 포함 여부를 정합니다.</p>
              </div>
            </div>

            <p class="bunny-notice">
              이 방식을 실제 제작 범위로 구체화한 내용은
              <a href={internalPath('affordable-homepage/')}>가성비 홈페이지 제작</a> 페이지에서 자세히 확인할 수 있습니다.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 5. SNS vs 홈페이지 -->
          <div class="bunny-section">
            <div class="bunny-section-head center">
              <p class="bunny-process-label">SNS VS HOMEPAGE</p>
              <h2 class="bunny-process-title">SNS만 있어도 홈페이지가 필요한가요?</h2>
              <p class="bunny-process-desc">
                SNS와 홈페이지는 서로 대체하는 관계가 아니라, 역할이 다른 채널입니다.
              </p>
            </div>

            <div class="bunny-website-grid">
              <div class="bunny-option-card bunny-option-custom">
                <div class="bunny-option-badge">SNS</div>
                <h3>인스타그램 · 네이버 블로그</h3>
                <p class="bunny-option-eng">UPDATES & COMMUNICATION</p>
                <p>새 소식, 이벤트, 후기처럼 자주 바뀌는 내용을 빠르게 알리고 소통하는 데 강점이 있습니다.</p>
              </div>

              <div class="bunny-option-card bunny-option-ai">
                <div class="bunny-option-badge">♡ 홈페이지</div>
                <h3>홈페이지</h3>
                <p class="bunny-option-eng">FIXED INFORMATION HUB</p>
                <p>매장 정보, 서비스, 가격, 위치처럼 항상 고정적으로 정리해 보여줘야 하는 정보를 담는 데 강점이 있습니다.</p>
              </div>
            </div>

            <p class="bunny-notice">
              둘 중 하나만 선택해야 하는 것은 아닙니다. SNS로 소식을 알리고, 홈페이지로
              정리된 정보와 문의를 받는 방식으로 함께 운영하는 경우가 많습니다.
            </p>
          </div>

          <div class="bunny-divider"></div>

          <!-- 6. 업종 예시 -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">EXAMPLE INDUSTRIES</p>
              <h2 class="bunny-process-title">어떤 업종에서 활용할 수 있나요?</h2>
              <p class="bunny-process-desc">
                아래는 제작 가능 예시이며, 바니코드가 해당 업종의 실제 고객을 보유하고
                있다는 뜻은 아닙니다.
              </p>
            </div>

            <div class="bunny-feature-grid">
              <span>음식점 / 카페</span>
              <span>미용 / 뷰티</span>
              <span>공방</span>
              <span>교육 / 레슨</span>
              <span>전문 서비스</span>
              <span>소규모 업체</span>
              <span>1인 사업</span>
            </div>
          </div>

          <div class="bunny-divider"></div>

          <!-- 7. FAQ -->
          <div class="bunny-section">
            <div class="bunny-section-head">
              <p class="bunny-process-label">FAQ</p>
              <h2 class="bunny-process-title">자주 묻는 질문</h2>
            </div>

            <Faq items={faqItems} />
          </div>

          <!-- FINAL CTA -->
          <div class="bunny-final">
            <p class="heart">♡ LET'S MAKE IT ♡</p>
            <h3>지금 운영 중인 매장·서비스를 알려주세요.</h3>
            <p>
              업종과 필요한 기능만 알려주시면<br />
              소상공인에게 맞는 제작 범위를 안내해드립니다.
            </p>
            <div class="bunny-buttons">
              <button type="button" class="bunny-btn bunny-btn-price" data-open-contact-modal>✉ 가격 문의하기</button>
              <a class="bunny-btn bunny-btn-kakao" href="https://open.kakao.com/o/gfMcjbOi" target="_blank" rel="noopener">💬 카카오톡 상담</a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

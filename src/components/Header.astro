---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="#home">
      <img src={`${base}assets/logo-bunny.png`} width="79" height="83" alt="버니코드 로고" />
      <span class="brand-name">버니코드</span>
    </a>

    <nav class="main-nav" aria-label="주요 메뉴">
      <a href="#home"><img src={`${base}assets/menu-bunny.png`} width="96" height="96" alt="" />홈</a>
      <a href="#service"><img src={`${base}assets/menu-bunny.png`} width="96" height="96" alt="" />서비스</a>
      <a href="#portfolio"><img src={`${base}assets/menu-bunny.png`} width="96" height="96" alt="" />포트폴리오</a>
      <a href="#process"><img src={`${base}assets/menu-bunny.png`} width="96" height="96" alt="" />진행방식</a>
      <a href="#contact"><img src={`${base}assets/menu-bunny.png`} width="96" height="96" alt="" />문의</a>
    </nav>
  </div>
</header>
